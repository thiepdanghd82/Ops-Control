# Ops Control — environment configuration template.
# Copy to .env, then edit for your deployment. The .env file is
# gitignored; this .example is the authoritative reference for what
# vars the server reads.

# ─── Runtime ────────────────────────────────────────────────────────
PORT=3000
# Data directory — library/cost JSON files + SQLite DB live here.
# Relative paths are resolved against the project root.
#
# Source-of-truth precedence (Sprint S-P0-FIX-1, 2026-05-03):
#   1. process.env.DATA_DIR set by the OS / service manager (highest)
#   2. DATA_DIR= in this file (read by dotenv at server boot)
#   3. fallback: ./server/data (built into server/index.js)
#
# dotenv.config() is called WITHOUT override:true, so an OS-set value
# wins over this file. deploy.sh and deploy.ps1 deliberately do NOT
# set DATA_DIR via systemd Environment= / NSSM AppEnvironmentExtra so
# this line stays authoritative across deploys.
DATA_DIR=./server/data

# Auto-update artifact directory served at /updates/* (Phase A.4).
# Default: <DATA_DIR>/../updates (sibling of the data dir).
# Override: absolute path OR relative to project root.
# Precedence: OS env > .env file > built-in default (matches DATA_DIR
# rules above). Endpoint quietly disables itself if the dir does not
# exist at boot — drop a latest.yml + installer in there to enable
# electron-updater.
# OPS_UPDATES_DIR=/opt/ops-control/updates

# 'development' enables permissive CORS for Vite dev server (:5173-5175).
# 'production' requires OPS_CORS_ORIGINS to be set (else same-origin only).
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. Empty = disabled (same-origin
# only). Production MUST set this if the client is served from a
# different origin than the API.
#   Example: OPS_CORS_ORIGINS=https://ops.example.com,https://staging.ops.example.com
OPS_CORS_ORIGINS=

# ─── TOTP encryption master key (REQUIRED in production) ────────────
# 32 random bytes, hex-encoded (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, TOTP secrets fall back to a PBKDF2 derivation from the
# admin password hash — still encrypted with ChaCha20-Poly1305 but
# weaker if the admin password is weak. Set this and rotate admin
# passwords independently.
OPS_TOTP_KEY=

# ─── Kiosk JWT signing key (REQUIRED in production for MES) ─────────
# 32 random bytes, hex-encoded (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to sign + verify kiosk pairing JWTs (apps/kiosk/). Without this,
# kiosk pairing fails at server boot — preflight will refuse to start.
# Rotate ONLY during maintenance window — operators must re-pair every
# kiosk after rotation (see CLAUDE.md kiosk pairing runbook).
OPS_KIOSK_KEY=

# ─── Rate limiting ──────────────────────────────────────────────────
# Per-IP budgets per 10-minute window. Raise carefully — these are
# protection against runaway scripts and brute-force, not legitimate
# usage ceilings. Auth login has its own limiter (10 attempts / 60s)
# which is not configurable here.
OPS_WRITE_RATE_MAX=30   # bulk import / backup endpoints
OPS_SAVE_RATE_MAX=120   # /save-all + /save-quotation (editor save clicks)

# ─── Storage backend ────────────────────────────────────────────────
# 'file' (default, JSON) or 'sqlite'. See server/repositories/README.
# Phase 7 cutover: set OPS_BACKEND_QUOTES=sqlite + observe 14 days
# before flipping OPS_QUOTES_STRICT_SQLITE=1.
OPS_DATA_BACKEND=file
# OPS_BACKEND_QUOTES=sqlite
# OPS_QUOTES_STRICT_SQLITE=1
# OPS_DB_PATH=/absolute/path/to/ops.db   # override default server/data/ops.db

# ─── Quote history caps ─────────────────────────────────────────────
# Max appended versions per quote in quote_versions table (older
# entries are pruned). Default 20 is sufficient for audit; bump to
# 50-100 if compliance requires full history.
OPS_MAX_QUOTE_VERSIONS=20

# ─── Notifications (optional) ───────────────────────────────────────
# Webhook URL for approval notification digests (Slack, Teams, email
# gateway). When unset, digest runs log only.
OPS_NOTIFY_WEBHOOK=
# HMAC secret — if set, the webhook POST is signed with
# X-Ops-Timestamp + X-Ops-Signature headers. Receiver must verify.
OPS_NOTIFY_WEBHOOK_SECRET=
# Cap on the in-memory notification queue. Older pending items are
# dropped when the cap is exceeded. Default 2000.
OPS_NOTIFICATIONS_CAP=2000

# ─── Backup retention ───────────────────────────────────────────────
# Days to keep automatic backup snapshots before cleanup. Default 30.
OPS_BACKUP_RETENTION_DAYS=30

# ─── Backup scheduler (REQUIRED in production) ─────────────────────
# Enable nightly automatic backup of ops.db + Library/ tarball.
# Without this, no backup runs (default OFF for dev convenience).
# Compliance: VN Law on Accounting Art. 41 requires 10-yr cost/quote
# retention — backup is the recovery mechanism. Lead Engineer (sysadmin function) MUST set this on prod .env
# to 1 on prod boxes.
OPS_BACKUP_SCHEDULE=1
# Hour of day to run backup (0-23, LOCAL TZ). Default 2 = 02:00 ICT
# to minimize impact on operator working hours.
OPS_BACKUP_HOUR=2

# ─── Audit retention (REQUIRED for VN compliance) ──────────────────
# When 1, daily scheduler rotates audit_log to gzip monthly archives
# (12 months kept). Without this, audit_log grows unbounded — disk
# fill eventually crashes the server.
OPS_AUDIT_RETENTION=1

# ─── Off-site backup (HIGHLY RECOMMENDED for production) ───────────
# Path (local OR remote) where Backup/ contents are mirrored daily.
# Examples:
#   /Volumes/USB_BACKUP_OPS                  (local USB drive)
#   /mnt/nas/ops-backup/                     (NAS mount)
#   backup-user@nas:/srv/ops-backup/         (remote via SSH/rsync)
# Cron at 02:30 LOCAL invokes scripts/backup-offsite.sh after main
# backup completes. Leave empty to disable (NOT recommended for prod).
OPS_OFFSITE_TARGET=

# ─── Server timezone (REQUIRED for backup scheduler) ──────────────
# Backup scheduler computes 02:00 LOCAL — must match prod box clock.
# Yen Phong factory uses ICT = UTC+7. CRITICAL: server `date` command
# must show ICT, not UTC, or 02:00 BACKUP_HOUR resolves to 09:00 ICT.
TZ=Asia/Ho_Chi_Minh

# Required by scripts/preflight-env.js — HMAC signing key for export verification
# Generate with: openssl rand -hex 32
OPS_EXPORT_HMAC_KEY=
