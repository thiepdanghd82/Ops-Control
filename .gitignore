# Secrets — NEVER commit. A leaked OPS_TOTP_KEY means every totp_secrets.enc
# ever encrypted with it is decryptable by whoever sees the repo.
.env
.env.local
.env.*.local

# v1.3 — Ed25519 license signing keys. Production private keys NEVER
# commit; live offline in the CCL HQ vault. Dev key is committed
# intentionally (whitelist below) so `npm test` works out-of-the-box.
scripts/license/*-private.pem
!scripts/license/dev-private.pem
desktop/license-pubkey.pem

# v1.3 — autonomous-upgrade artefacts (UPGRADE_LOG.md is checked in;
# raw backups + generated installers are not).
backup/v1.2_pre_upgrade_*.tar.gz
dist/*.dmg
dist/*.exe
_legacy/

# Quarantined secrets from reset-totp / broken decrypts. Forensics-only.
**/totp_secrets.enc.broken-*
**/totp_secrets.enc.corrupt-*

# Runtime DATA_DIR if someone sets it inside the repo by accident.
server/data/
!server/data/.gitkeep

# Build output
client/dist/
client/node_modules/
node_modules/

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
!.vscode/launch.json
.claude/

# Local logs
*.log
npm-debug.log*

# Runtime artefacts created by seed-admin / authService when run
# outside the desktop sandbox (i.e. directly from the project root).
/users.json
/README_FIRST_LOGIN.txt
client/public/help/*.docx

# Sprint MES-2.8 — Playwright e2e artefacts.
playwright-report/
test-results/
.playwright-tmp/
dist-release/
desktop/dist-electron/
desktop/package.json.backup-*
Data for import/

# UAT raw feedback — contains customer PII, never commit
   docs/uat/runs/*/feedback.md
   docs/uat/runs/*/screenshots/

