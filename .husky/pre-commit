# Husky pre-commit hook — runs lint-staged on touched files only.
# Full `npm test` runs in CI on push (.github/workflows/ci.yml). Pre-commit
# stays fast (~5 sec) so engineers don't bypass via --no-verify.

# Skip lint-staged on merge commits — constituent commits already passed lint individually,
# and bulk-scanning a large merge delta surfaces unrelated pre-existing issues.
if [ -n "$(git rev-parse -q --verify MERGE_HEAD)" ]; then
  exit 0
fi

npx lint-staged || exit 1
