#!/usr/bin/env sh
# Husky pre-commit hook — runs lint-staged on changed files.
# Activates only when project is under git. Skip with `git commit --no-verify`
# only as last resort.

# Skip lint-staged on merge commits — constituent commits already passed lint individually,
# and bulk-scanning a large merge delta surfaces unrelated pre-existing issues.
if [ -n "$(git rev-parse -q --verify MERGE_HEAD)" ]; then
  exit 0
fi

npx lint-staged || exit 1
